[Unit]
Description=Kyle IT Support Desk Flask API
After=network.target

[Service]
User=ec2-user
Group=ec2-user
WorkingDirectory=/home/ec2-user/kyle-it
Environment="PATH=/home/ec2-user/kyle-it/venv/bin"
ExecStart=/home/ec2-user/kyle-it/venv/bin/gunicorn --workers 2 --bind 127.0.0.1:5000 app:app
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
